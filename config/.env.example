# DocCloud — config/.env (written by the kernel's installer at apply; design §14). Never commit the real file.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="DocCloud"
APP_KEY=doccloud
APP_URL=https://doccloud.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_doccloud
DB_USER=doccloud_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=doccloud_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=doccloud_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 0)
APP_INTERNAL_PORT=8190
MCP_RECORDS_PORT=8841
MCP_ACTIVITY_PORT=8842
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes)
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# the document graph's own memory database (ROOT_STEPS.sh steps 3 and 4; read in app/doccloud/graph.php alone)
MALUDB_DC_API_URL=http://127.0.0.1:8000
MALUDB_DC_API_TOKEN=
# mail (optional; the installer fills them from ~/.malumail or the kernel's)
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# the bytes: default storage/blobs under the install; a mount the owner names (the owner's answer (c))
DC_STORAGE_DIR=
# may only LOWER dc_settings.max_document_bytes
DC_MAX_DOCUMENT_BYTES=
# text extraction and thumbnails when not on PATH
DC_PDFTOTEXT=
DC_PDFTOPPM=
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
