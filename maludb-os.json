{
  "schema": "maludb-os.application/1",
  "catalog_key": "doccloud",
  "name": "DocCloud",
  "description": "The business's document cloud — what Dropbox, Box and Nextcloud are to a business: libraries (personal, group, shared) of folders and documents with every version kept and the bytes stored once, group libraries that outlive their members, sharing to people, groups, departments and agents with inheritance down the tree and, through expiring links and file requests, the outside; tags, a keyword search over the words of every document, and a dedicated knowledge graph for finding documents that is kept apart from what the agents remember and never searched by the default ask-me-anything. Every search answers only what the asker may see. The DocCloud Expert finds, files and explains access in the command bar; the Filing Clerk reports every Monday what the store needs a hand with.",
  "business_area": "Operations",
  "category": "storage",
  "icon": "feather-hard-drive",
  "version": "0.1.0",
  "criticality": "medium",
  "vhost": {
    "label": "doccloud",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "doccloud",
    "migrations": "db",
    "roles": {
      "rw": "doccloud_rw",
      "records_ro": "doccloud_records_ro",
      "activity_ro": "doccloud_activity_ro"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "MCP_RECORDS_DB_USER",
      "MCP_RECORDS_DB_PASSWORD",
      "MCP_ACTIVITY_DB_USER",
      "MCP_ACTIVITY_DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "MCP_RECORDS_PORT",
      "MCP_ACTIVITY_PORT",
      "ACTION_TOKEN_KEY",
      "ACTIONS_RELAY_KEY",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL",
      "APP_KEY",
      "MALUDB_API_URL",
      "MALUDB_API_TOKEN"
    ],
    "optional": [
      "MALUMAIL_API_KEY",
      "MAIL_FROM",
      "MAIL_FROM_NAME",
      "MALUDB_DC_API_URL",
      "MALUDB_DC_API_TOKEN",
      "DC_STORAGE_DIR",
      "DC_MAX_DOCUMENT_BYTES",
      "DC_PDFTOTEXT",
      "DC_PDFTOPPM"
    ]
  },
  "services": [
    "deploy/doccloud-records-mcp.service",
    "deploy/doccloud-activity-mcp.service",
    "deploy/doccloud-activity-ingest.service",
    "deploy/doccloud-activity-ingest.timer",
    "deploy/doccloud-directory-sync.service",
    "deploy/doccloud-directory-sync.timer",
    "deploy/doccloud-worker.service",
    "deploy/doccloud-worker.timer"
  ],
  "endpoints": [
    {
      "name": "Web UI",
      "kind": "ui",
      "path": "/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Health",
      "kind": "http_api",
      "path": "/api/v1/health",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Shared link",
      "kind": "ui",
      "path": "/s/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "File request",
      "kind": "ui",
      "path": "/r/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Documents API",
      "kind": "http_api",
      "path": "/api/v1/",
      "auth_kind": "bearer",
      "agent_reachable": false
    },
    {
      "name": "Records MCP",
      "kind": "mcp",
      "path": "/mcp/records",
      "auth_kind": "bearer",
      "agent_reachable": true,
      "mcp_surface_version": 1
    },
    {
      "name": "Activity MCP",
      "kind": "mcp",
      "path": "/mcp/activity",
      "auth_kind": "bearer",
      "agent_reachable": true,
      "mcp_surface_version": 1
    }
  ],
  "actions": {
    "manifest": "docs/doccloud-action-manifest.md",
    "registry": "mcp/action_registry.json",
    "base_url_env": "APP_INTERNAL_PORT"
  },
  "skills": [
    "skills/doccloud-basics",
    "skills/finding-documents",
    "skills/sharing-well",
    "skills/tagging",
    "skills/file-an-incoming-document",
    "skills/propose-tags-from-the-graph",
    "skills/share-a-folder-with-a-group",
    "skills/monday-store-report",
    "skills/clean-up-duplicates"
  ],
  "sso": {
    "path": "/sso",
    "logout_path": "/sso/logout"
  },
  "directory": {
    "reads": true,
    "writes": false
  },
  "assistant": {
    "command_bar": true,
    "agent": "expert"
  },
  "roles": [
    {
      "key": "guest",
      "name": "Guest",
      "description": "An external: nothing by default; reaches only the folders and documents shared to them by name, and may upload or edit where the share says so.",
      "capability": "read",
      "is_admin": false,
      "rights": [
        "documents.guest"
      ]
    },
    {
      "key": "user",
      "name": "Member",
      "description": "Everyone inside the business: a personal library, uploads, folders, tags, sharing inside the business, links and file requests, the search and the graph.",
      "capability": "write",
      "is_admin": false,
      "rights": [
        "library.personal",
        "documents.upload",
        "documents.edit",
        "documents.share",
        "links.make",
        "requests.make",
        "tags.apply",
        "search.use",
        "graph.use",
        "versions.restore",
        "trash.own",
        "export.own"
      ]
    },
    {
      "key": "curator",
      "name": "Curator",
      "description": "Makes groups and shared libraries, keeps the tag vocabulary and auto-tag rules, transfers a leaver's documents, reads the storage and search reports.",
      "capability": "write",
      "is_admin": false,
      "rights": [
        "library.personal",
        "documents.upload",
        "documents.edit",
        "documents.share",
        "links.make",
        "requests.make",
        "tags.apply",
        "search.use",
        "graph.use",
        "versions.restore",
        "trash.own",
        "export.own",
        "groups.manage",
        "libraries.shared",
        "tags.manage",
        "ownership.transfer",
        "reports.storage",
        "reports.search"
      ]
    },
    {
      "key": "admin",
      "name": "DocCloud admin",
      "description": "Every library including personal ones (logged), the settings, quotas, the versions and trash windows, the graph policy, budget and model, every link, purge, the costs. A super-admin holds this role.",
      "capability": "admin",
      "is_admin": true,
      "rights": [
        "library.personal",
        "documents.upload",
        "documents.edit",
        "documents.share",
        "links.make",
        "requests.make",
        "tags.apply",
        "search.use",
        "graph.use",
        "versions.restore",
        "trash.own",
        "export.own",
        "groups.manage",
        "libraries.shared",
        "tags.manage",
        "ownership.transfer",
        "reports.storage",
        "reports.search",
        "settings.manage",
        "quotas.manage",
        "retention.manage",
        "graph.manage",
        "links.all",
        "trash.purge",
        "agents.settings",
        "costs.read",
        "library.admin_view"
      ]
    }
  ],
  "shares": [
    {
      "tool": "folders_index",
      "description": "The folders shared with the requesting application: id, path, document count, updated (os.doccloud-folders/1)",
      "scoped": false
    },
    {
      "tool": "documents_index",
      "description": "The documents of a folder shared with the requesting application, its subtree included: id, name, kind, size, sha256, tags, owner, version, updated — paged, with `since` (os.doccloud-documents/1)",
      "scoped": false
    },
    {
      "tool": "document_text",
      "description": "The extracted text of one document in a shared folder, with its pages, at most 5 MB — Knowledge's feed (os.doccloud-text/1)",
      "scoped": false,
      "timeout_seconds": 60
    },
    {
      "tool": "document_link",
      "description": "A signed ten-minute download URL for one document in a shared folder; the bytes never cross the kernel's JSON and the open is logged under the consumer (os.doccloud-link/1)",
      "scoped": false
    }
  ],
  "reads": [],
