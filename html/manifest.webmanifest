{
  "name": "DocCloud",
  "short_name": "DocCloud",
  "description": "The business's files: libraries, folders and documents with every version, shared with people and groups, found by name, tag, keyword or the document graph.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
